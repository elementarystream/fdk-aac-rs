# fdk-aac-rs: Third-Party Modified Version of the Fraunhofer FDK AAC Codec Library for Android.
# A Rust port of fdk-aac 2.0.3. See LICENSE.txt for the complete license text.
#
# Package version file, installed as <libdir>/cmake/fdk-aac/fdk-aac-config-version.cmake. Same
# rule as upstream's write_basic_package_version_file(... COMPATIBILITY SameMinorVersion):
# compatible with a request of the same major and minor version and a patch level not above
# @PACKAGE_VERSION@.

set(PACKAGE_VERSION "@PACKAGE_VERSION@")

if(PACKAGE_FIND_VERSION_RANGE)
  # Ranges: accept if the version is inside the range.
  if((PACKAGE_FIND_VERSION_RANGE_MIN STREQUAL "INCLUDE"
        AND PACKAGE_VERSION VERSION_GREATER_EQUAL PACKAGE_FIND_VERSION_MIN)
      AND ((PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "INCLUDE"
            AND PACKAGE_VERSION VERSION_LESS_EQUAL PACKAGE_FIND_VERSION_MAX)
        OR (PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "EXCLUDE"
            AND PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION_MAX)))
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
  else()
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
  endif()
elseif(NOT PACKAGE_FIND_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
else()
  string(REGEX MATCH "^([0-9]+)\\.([0-9]+)" _match "${PACKAGE_VERSION}")
  set(_major "${CMAKE_MATCH_1}")
  set(_minor "${CMAKE_MATCH_2}")
  if(PACKAGE_FIND_VERSION_MAJOR STREQUAL _major
      AND PACKAGE_FIND_VERSION_MINOR STREQUAL _minor
      AND NOT PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
  else()
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
  endif()
  if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
  unset(_match)
  unset(_major)
  unset(_minor)
endif()
